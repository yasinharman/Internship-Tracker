# Copy to .env and fill in. .env is gitignored - never commit real credentials.
# On the server these are set as Coolify environment variables instead.

#############
# DATABASE  #
#############
DB_USER=postgres
DB_PASSWORD=change_me
DB_NAME=job_applications_db

# Used directly by app.py / pipelines.py when running outside docker-compose.
# Inside compose the host is 'db', not 'localhost'.
# A `postgres://` string from a hosting panel is accepted too - it is
# rewritten to `postgresql://` at connect time.
DATABASE_URL=postgresql://postgres:change_me@localhost:5432/job_applications_db


##########################################
# LLM FIELD CLASSIFIER                   #
##########################################
# Decides whether a posting is software work, a company-wide internship with
# no department named yet, or somebody else's field. Replaces a word list that
# Turkish inflection kept defeating - see MultiwebsiteScraper/classifier.py.

# openai | anthropic. The classifier keeps a thin seam for both so models can
# be compared; only the openai SDK is in requirements.txt.
LLM_PROVIDER=openai

# Chosen by measurement over 130 real postings: gpt-5.4-mini matched the
# flagship reference on 122/130, while the cheaper gpt-5.4-nano hid two real
# matches (an internship with "IT" in its title, and a company-wide "Intern").
CLASSIFIER_MODEL=gpt-5.4-mini

# Independent requests, network-bound. 8 keeps 150 postings under a minute.
CLASSIFY_CONCURRENCY=8

# Ceiling for a hung provider, not an expected duration.
CLASSIFY_TIMEOUT=900

# Linking the same job across boards (dedupe_jobs.py) is pure SQL over a few
# hundred rows, so this is a ceiling for a wedged process, not a duration.
DEDUPE_TIMEOUT=120

OPENAI_API_KEY=
# Only needed if LLM_PROVIDER=anthropic (also: pip install anthropic).
ANTHROPIC_API_KEY=


##########################################
# RESIDENTIAL PROXY (IPRoyal)            #
##########################################
# off  - never use the proxy. Correct for local development.
# auto - go direct, switch to the proxy as soon as a block is detected, and
#        keep using it for that domain afterwards. Cheapest on bandwidth.
# on   - route everything through the proxy. Use if 'auto' is burning too
#        many requests on blocks.
PROXY_MODE=auto

IPROYAL_HOST=geo.iproyal.com
IPROYAL_PORT=12321
IPROYAL_USERNAME=
IPROYAL_PASSWORD=

# Exit country. Turkish job boards serve TR visitors, so a TR exit IP is the
# least surprising. Empty = worldwide.
IPROYAL_COUNTRY=tr

# How long IPRoyal holds one sticky IP: 10m / 30m / 1h ...
# Long enough to finish a paginated search from a single address.
IPROYAL_SESSION_LIFETIME=30m

# Deliberately change exit IP every N requests. 0 disables rotation.
PROXY_ROTATE_AFTER=50

# Overrides every IPROYAL_* value above. Two uses:
#   - testing another provider
#   - a STATIC residential / ISP address, which is what IPRoyal hands you as
#     a plain ip:port with its own credentials rather than a geo.iproyal.com
#     endpoint. Everything above (country, session, lifetime, rotation) is a
#     pool feature and simply does not apply; the code detects the single
#     fixed address and stops pretending it can rotate away from it.
# PROXY_URL=http://user:pass@host:port
PROXY_URL=

# With a dedicated address PROXY_MODE=on is usually the better setting:
# 'auto' deliberately eats one blocked request per domain to discover what we
# already know, and a static plan is not metered by the gigabyte, so there is
# no bandwidth saved by going direct first.


##########################################################
# WHICH BROWSER THE INDEED SPIDER PRETENDS TO BE          #
##########################################################
# Normally leave this empty: the spider falls through its own measured list
# of TLS fingerprints (see spiders/indeed_cards.py) and BlockDetectionMiddleware
# moves to the next one when Cloudflare challenges the current one.
#
# Set it to pin a single token for an experiment - e.g. INDEED_IMPERSONATE=chrome124.
# Re-measure the list with: python -m MultiwebsiteScraper.tls_probe
INDEED_IMPERSONATE=
#
# WHEN A SESSION IS LOADED, the browser that created it leads the ladder
# instead - a session presented under another browser's handshake gets
# challenged even when that handshake is the one measuring clean anonymously
# (measured 30.07.2026: 8 of 11 requests refused that way, 61 of 61 answered
# the right way). Change this only if the session was exported from something
# other than Firefox.
INDEED_SESSION_BROWSER=


##########################################################
# INDEED SESSION - A REAL SIGNED-IN BROWSER              #
##########################################################
# Indeed gives an anonymous visitor ONE page of results per search and asks
# everyone else to sign in. Leave this empty and the spider takes that one
# page and stops, which works and needs no account - but measured 30.07.2026,
# a session is worth fifteen pages per search instead of one.
#
# To go deeper, sign in with a browser and paste its session here. THIS VALUE
# IS THE ACCOUNT - treat it like a password.
#
#   1. Point the browser at the same proxy the spider uses, so the account
#      and the exit address are consistent from the moment it is created.
#   2. Sign in with FIREFOX. Cloudflare currently challenges every Chrome
#      fingerprint curl_cffi can replay and lets Firefox through, so a
#      Chrome session would have to be used under a Firefox identity - which
#      is a session being used by something other than what made it.
#   3. DevTools -> Network -> any request to tr.indeed.com -> Request
#      Headers -> Cookie -> copy the whole value.
#   4. Paste it below, on one line.
#
# EXCEPT that pasting rarely survives: the header is ~5 KB and has double
# quotes inside its values (RF=, SOCK=, SHOE=, PREF=), which no .env quoting
# style gets through intact. Use one of the other two forms.
#
# A path to a file holding the same thing (or a cookie-exporter's JSON). It
# MUST be absolute: the spider runs with cwd=MultiwebsiteScraper, so a bare
# filename resolves in the wrong directory - and that cost a run once.
#   INDEED_COOKIES=/run/secrets/indeed_cookies.json
#
# Base64 of the header, which is the one to use on a hosting panel - no
# quotes, no semicolons, nothing to escape, and no file to mount. Wins over
# INDEED_COOKIES when both are set. Produce it with:
#   python -c "import base64,sys;print(base64.b64encode(open(sys.argv[1],'rb').read().strip()).decode())" indeed-cookies.txt
#   INDEED_COOKIES_B64=Q1RLPWFiYy4uLg==
INDEED_COOKIES_B64=
#
# When it expires the spider says so in as many words and tells you it is not
# a proxy problem. Repeat the steps above. Measured 30.07.2026: a session
# still opened page two three hours after export, long after its oauth
# cookies had filled up, so this is maintenance rather than a daily chore.
INDEED_COOKIES=


#############
# DEBUGGING #
#############
# 1 = write every raw API response to debug/<spider>/ while developing a new
# endpoint. Leave off in production; it writes a file per request.
API_DEBUG_DUMP=0


##################################
# LEGACY (old DOM-parse spiders) #
##################################
SCRAPEOPS_API_KEY=
