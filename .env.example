# Copy to .env and fill in. .env is gitignored - never commit real credentials.
# On the server these are set as Coolify environment variables instead.

#############
# DATABASE  #
#############
DB_USER=postgres
DB_PASSWORD=change_me
DB_NAME=job_applications_db

# Used directly by api/ and pipelines.py when running outside docker-compose.
# Inside compose the host is 'db', not 'localhost'.
# A `postgres://` string from a hosting panel is accepted too - it is
# rewritten to `postgresql://` at connect time.
DATABASE_URL=postgresql://postgres:change_me@localhost:5432/job_applications_db


##########################################
# DASHBOARD (api/ + web/)                #
##########################################
# Which midnight "Bugün Eklenen" means, and which day a posting is grouped
# into on the chart. created_at is stored as UTC, but the user and every site
# scraped are on Turkish time - without this the day rolls over at 03:00
# local, which is what app.py used to do by accident.
DASHBOARD_TZ=Europe/Istanbul

# Seconds to wait for the TCP handshake to Postgres before giving up.
# Not a tuning knob: psycopg2 otherwise inherits the OS timeout of about two
# minutes, so an unreachable database makes every request - including
# /api/health - hang instead of answering. A health check that hangs is read
# as "the process is dead", which sends you to look at the wrong thing.
DB_CONNECT_TIMEOUT=10


##########################################
# LLM FIELD CLASSIFIER                   #
##########################################
# Decides whether a posting is software work, a company-wide internship with
# no department named yet, or somebody else's field. Replaces a word list that
# Turkish inflection kept defeating - see scraper/classifier.py.

# openai | anthropic. The classifier keeps a thin seam for both so models can
# be compared; only the openai SDK is in requirements.txt.
LLM_PROVIDER=openai

# Chosen by measurement over 130 real postings: gpt-5.4-mini matched the
# flagship reference on 122/130, while the cheaper gpt-5.4-nano hid two real
# matches (an internship with "IT" in its title, and a company-wide "Intern").
CLASSIFIER_MODEL=gpt-5.4-mini

# Independent requests, network-bound. 8 keeps 150 postings under a minute.
CLASSIFY_CONCURRENCY=8

# Ceiling for a hung provider, not an expected duration.
CLASSIFY_TIMEOUT=900

# Linking the same job across boards (pipeline/dedupe_jobs.py) is pure SQL over a few
# hundred rows, so this is a ceiling for a wedged process, not a duration.
DEDUPE_TIMEOUT=120

OPENAI_API_KEY=
# Only needed if LLM_PROVIDER=anthropic (also: pip install anthropic).
ANTHROPIC_API_KEY=


##########################################
# RESIDENTIAL PROXY (IPRoyal) - NOT IN USE
##########################################
# Left off deliberately as of 21.08.2026. The crawl is run by hand from a
# local machine whose own connection is residential, which is the only
# property Indeed and kariyer.net actually check for - so there is nothing for
# a proxy to add, and nothing metered to pay for. PROXY_MODE=off, and none of
# the IPROYAL_* values below need filling in.
#
# Turn it back on if the crawl ever moves to a datacenter address (a VPS, CI,
# a container on a hosting panel). There it will be refused on every
# handshake, and this section is the fix rather than an optimisation.
# off  - never use the proxy. THIS IS THE CURRENT SETTING and the right one
#        while the crawl runs from a residential home connection.
# auto - go direct, switch to the proxy as soon as a block is detected, and
#        keep using it for that domain afterwards. Cheapest on bandwidth.
# on   - route everything through the proxy. Use if 'auto' is burning too
#        many requests on blocks.
PROXY_MODE=off

IPROYAL_HOST=geo.iproyal.com
IPROYAL_PORT=12321
IPROYAL_USERNAME=
IPROYAL_PASSWORD=

# Exit country. Turkish job boards serve TR visitors, so a TR exit IP is the
# least surprising. Empty = worldwide.
IPROYAL_COUNTRY=tr

# How long IPRoyal holds one sticky IP: 10m / 30m / 1h ...
# Long enough to finish a paginated search from a single address.
IPROYAL_SESSION_LIFETIME=30m

# Deliberately change exit IP every N requests. 0 disables rotation.
PROXY_ROTATE_AFTER=50

# Overrides every IPROYAL_* value above. Two uses:
#   - testing another provider
#   - a STATIC residential / ISP address, which is what IPRoyal hands you as
#     a plain ip:port with its own credentials rather than a geo.iproyal.com
#     endpoint. Everything above (country, session, lifetime, rotation) is a
#     pool feature and simply does not apply; the code detects the single
#     fixed address and stops pretending it can rotate away from it.
# PROXY_URL=http://user:pass@host:port
PROXY_URL=

# With a dedicated address PROXY_MODE=on is usually the better setting:
# 'auto' deliberately eats one blocked request per domain to discover what we
# already know, and a static plan is not metered by the gigabyte, so there is
# no bandwidth saved by going direct first.


##########################################################
# WHICH BROWSER THE INDEED SPIDER PRETENDS TO BE          #
##########################################################
# Normally leave this empty: the spider falls through its own measured list
# of TLS fingerprints (see spiders/indeed_cards.py) and BlockDetectionMiddleware
# moves to the next one when Cloudflare challenges the current one.
#
# Set it to pin a single token for an experiment - e.g. INDEED_IMPERSONATE=chrome124.
# Re-measure the list with: python -m scraper.tls_probe
INDEED_IMPERSONATE=
#
# WHEN A SESSION IS LOADED, the browser that created it leads the ladder
# instead - a session presented under another browser's handshake gets
# challenged even when that handshake is the one measuring clean anonymously
# (measured 30.07.2026: 8 of 11 requests refused that way, 61 of 61 answered
# the right way). Change this only if the session was exported from something
# other than Firefox.
INDEED_SESSION_BROWSER=


##########################################################
# INDEED SESSION - A REAL SIGNED-IN BROWSER              #
##########################################################
# Indeed gives an anonymous visitor ONE page of results per search and asks
# everyone else to sign in. Leave this empty and the spider takes that one
# page and stops, which works and needs no account - but measured 30.07.2026,
# a session is worth fifteen pages per search instead of one.
#
# To go deeper, sign in with a browser and paste its session here. THIS VALUE
# IS THE ACCOUNT - treat it like a password.
#
#   1. Sign in from the same connection the spider runs on, so the account
#      and the address are consistent from the moment it is created. (With a
#      proxy configured, point the browser at that proxy instead.)
#   2. Sign in with FIREFOX. Cloudflare currently challenges every Chrome
#      fingerprint curl_cffi can replay and lets Firefox through, so a
#      Chrome session would have to be used under a Firefox identity - which
#      is a session being used by something other than what made it.
#   3. DevTools -> Network -> any request to tr.indeed.com -> Request
#      Headers -> Cookie -> copy the whole value.
#   4. Paste it below, on one line.
#
# EXCEPT that pasting rarely survives: the header is ~5 KB and has double
# quotes inside its values (RF=, SOCK=, SHOE=, PREF=), which no .env quoting
# style gets through intact. Use one of the other two forms.
#
# A path to a file holding the same thing (or a cookie-exporter's JSON). It
# MUST be absolute: the spider runs with cwd=scraper, so a bare
# filename resolves in the wrong directory - and that cost a run once.
#   INDEED_COOKIES=/run/secrets/indeed_cookies.json
#
# Base64 of the header, which is the one to use on a hosting panel - no
# quotes, no semicolons, nothing to escape, and no file to mount. Wins over
# INDEED_COOKIES when both are set. Produce it with:
#   python -c "import base64,sys;print(base64.b64encode(open(sys.argv[1],'rb').read().strip()).decode())" indeed-cookies.txt
#   INDEED_COOKIES_B64=Q1RLPWFiYy4uLg==
INDEED_COOKIES_B64=
#
# When it expires the spider says so in as many words and tells you it is not
# a proxy problem. Repeat the steps above. Measured 30.07.2026: a session
# still opened page two three hours after export, long after its oauth
# cookies had filled up, so this is maintenance rather than a daily chore.
INDEED_COOKIES=
#
# The FULL session - cookies plus localStorage/sessionStorage - written by
# `python -m tools.save_session indeed`. PlaywrightMiddleware reads this FIRST and
# falls back to the cookie-only forms above when it is unset. Absolute path.
INDEED_STORAGE_STATE=


##########################################################
# LINKEDIN SESSION - A BURNER ACCOUNT, NOT A PERSONAL ONE #
##########################################################
# LinkedIn serves an anonymous visitor NOTHING useful: guest requests to the
# job search are refused outright, so unlike Indeed there is no one-page
# anonymous mode to fall back to. No session, no LinkedIn postings - and the
# spider says so and stops rather than reporting a successful empty crawl.
#
# USE AN ACCOUNT YOU CAN AFFORD TO LOSE. LinkedIn treats automation as a terms
# violation and closes accounts permanently when it notices. That is the whole
# reason LinkedIn was out of scope until 26.08.2026 (docs/sites/linkedin.md) and the
# only thing that changed is whose account is at risk. Never point this at a
# personal profile.
#
#   1. Open the burner account from the same connection the spider runs on,
#      so the account and the address stay consistent.
#   2. python -m tools.save_session linkedin
#      A visible browser window opens on the login page. Sign in by hand;
#      2FA and captchas are fine, the script just waits for the `li_at`
#      cookie to appear, then saves and closes the window on its own.
#   3. Paste the absolute path it prints below.
#
# The file IS the account - gitignored, never committed, never pasted
# anywhere. When it expires the spider reports a sign-in wall explicitly and
# tells you it is not an address problem; re-run step 2.
LINKEDIN_STORAGE_STATE=
#
# Cookie-only fallbacks, same three shapes as INDEED_COOKIES above (a header
# string, a path to a file, or _B64 of either). Weaker than the storage state
# - they carry no localStorage - so prefer the file above and keep these for
# a hosting panel that has a text box and no filesystem.
LINKEDIN_COOKIES_B64=
LINKEDIN_COOKIES=


#############
# DEBUGGING #
#############
# 1 = write every raw API response to debug/<spider>/ while developing a new
# endpoint. Leave off in production; it writes a file per request.
API_DEBUG_DUMP=0


##########################################################
# HERMES WEBHOOK - TELEGRAM PING FOR WATCHED COMPANIES    #
##########################################################
# pipeline/notify_watchlist.py posts here after every crawl (see main.py's
# run_post_crawl) for postings whose company matches config/watched_companies.yml.
# The route lives on the same server, outside Docker - see the Hermes
# agent's own docs for `hermes webhook subscribe`. Not the public webhook
# platform default (8644) reachable from just anywhere: the server's ufw
# only allows this port from the Docker-internal ranges and localhost, so
# this only works from a container that actually runs on that host.
HERMES_WEBHOOK_URL=http://<server-ip>:8644/webhooks/job-watchlist

# The HMAC secret `hermes webhook subscribe` printed when the route was
# created. Treat it like a password - whoever has it can trigger the
# Telegram ping.
HERMES_WEBHOOK_SECRET=

# Ceiling for a single POST to Hermes, not the whole notify step - see
# NOTIFY_TIMEOUT in main.py for that.
NOTIFY_REQUEST_TIMEOUT=10


##########################################################
# IS EACH STORED POSTING STILL ON OFFER?                 #
##########################################################
# After every crawl, the *_check spiders ask each site whether the postings
# the board can still show are actually still open, and set job_posts.closed_at
# on the ones that are not. The dashboard hides those by default and reveals
# them with the "Kapananlar" toggle. See docs/pipeline.md for the per-site signal.

# Ceiling for ONE site's check, not all three - main.py applies it per spider.
# Measured 21.08.2026: 60 Indeed postings at its 6s delay is about six minutes,
# kariyer.net's 14 at 4s about one, techcareer's 5 at 1.5s a few seconds.
# Generous on purpose: a checker killed halfway just leaves the rest
# unchecked, so this should only ever catch a genuinely wedged process.
CHECK_TIMEOUT=1200

# Most postings checked per site per run. 0 = no ceiling, which is right while
# the board is small - only the ~79 postings the board can show are checked,
# never the classifier's hidden pile, so the cost scales with the board rather
# than the archive.
#
# Set it if a site starts refusing us: the longest-unchecked postings go
# first, so the cost is capped and every row still gets its turn eventually.
OPENINGS_MAX_PER_SITE=0


##################################
# LEGACY (old DOM-parse spiders) #
##################################
SCRAPEOPS_API_KEY=
