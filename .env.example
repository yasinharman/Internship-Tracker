# Copy to .env and fill in. .env is gitignored - never commit real credentials.
# On the server these are set as Coolify environment variables instead.

#############
# DATABASE  #
#############
DB_USER=postgres
DB_PASSWORD=change_me
DB_NAME=job_applications_db

# Used directly by app.py / pipelines.py when running outside docker-compose.
# Inside compose the host is 'db', not 'localhost'.
DATABASE_URL=postgresql+psycopg2://postgres:change_me@localhost:5432/job_applications_db


##########################################
# LLM FIELD CLASSIFIER                   #
##########################################
# Decides whether a posting is software work, a company-wide internship with
# no department named yet, or somebody else's field. Replaces a word list that
# Turkish inflection kept defeating - see MultiwebsiteScraper/classifier.py.

# openai | anthropic. The classifier keeps a thin seam for both so models can
# be compared; only the openai SDK is in requirements.txt.
LLM_PROVIDER=openai

# Chosen by measurement over 130 real postings: gpt-5.4-mini matched the
# flagship reference on 122/130, while the cheaper gpt-5.4-nano hid two real
# matches (an internship with "IT" in its title, and a company-wide "Intern").
CLASSIFIER_MODEL=gpt-5.4-mini

# Independent requests, network-bound. 8 keeps 150 postings under a minute.
CLASSIFY_CONCURRENCY=8

# Ceiling for a hung provider, not an expected duration.
CLASSIFY_TIMEOUT=900

OPENAI_API_KEY=
# Only needed if LLM_PROVIDER=anthropic (also: pip install anthropic).
ANTHROPIC_API_KEY=


##########################################
# RESIDENTIAL PROXY (IPRoyal)            #
##########################################
# off  - never use the proxy. Correct for local development.
# auto - go direct, switch to the proxy as soon as a block is detected, and
#        keep using it for that domain afterwards. Cheapest on bandwidth.
# on   - route everything through the proxy. Use if 'auto' is burning too
#        many requests on blocks.
PROXY_MODE=auto

IPROYAL_HOST=geo.iproyal.com
IPROYAL_PORT=12321
IPROYAL_USERNAME=
IPROYAL_PASSWORD=

# Exit country. Turkish job boards serve TR visitors, so a TR exit IP is the
# least surprising. Empty = worldwide.
IPROYAL_COUNTRY=tr

# How long IPRoyal holds one sticky IP: 10m / 30m / 1h ...
# Long enough to finish a paginated search from a single address.
IPROYAL_SESSION_LIFETIME=30m

# Deliberately change exit IP every N requests. 0 disables rotation.
PROXY_ROTATE_AFTER=50

# Overrides every IPROYAL_* value above. For testing another provider:
# PROXY_URL=http://user:pass@host:port
PROXY_URL=


#############
# DEBUGGING #
#############
# 1 = write every raw API response to debug/<spider>/ while developing a new
# endpoint. Leave off in production; it writes a file per request.
API_DEBUG_DUMP=0


##################################
# LEGACY (old DOM-parse spiders) #
##################################
SCRAPEOPS_API_KEY=
